# Copy to ".env" and load it before running (e.g. `set -a; . ./.env; set +a`).
#
# From your FastPix Dashboard (https://dashboard.fastpix.com):
#   Access Token -> FASTPIX_USERNAME
#   Secret Key   -> FASTPIX_PASSWORD
FASTPIX_USERNAME=
FASTPIX_PASSWORD=

# From Dashboard > Webhooks, used to verify the FastPix-Signature on /webhooks.
FASTPIX_WEBHOOK_SECRET=
